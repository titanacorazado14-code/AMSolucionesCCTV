<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AM Soluciones</title>
    <link rel="stylesheet" href="~/css/am.css" asp-append-version="true" />
</head>
<body>
    <header class="barra">
        <div class="barra-interior">
            <a class="marca" asp-page="/Index">
                <span class="marca-icono">&#9673;</span>
                <span class="marca-texto">
                    <strong>AM Soluciones</strong>
                    <small>Cámaras y seguridad electrónica</small>
                </span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="menu">
                    <a asp-page="/Index">Inicio</a>
                    <a asp-page="/Categorias/Index">Categorías</a>
                    <a asp-page="/Productos/Index">Productos</a>
                    <a asp-page="/Inventario/Index">Inventario</a>
                    <a asp-page="/Ventas/Index">Ventas</a>
                </nav>

                <form class="usuario" method="post" asp-page="/Logout">
                    <span>
                        @User.Identity.Name
                        <em>(@(string.Join(", ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))))</em>
                    </span>
                    <button type="submit" class="boton boton-claro">Salir</button>
                </form>
            }
        </div>
    </header>

    <main class="contenido">
        @if (TempData["Exito"] is string exito)
        {
            <div class="alerta alerta-exito">@exito</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alerta alerta-error">@error</div>
        }

        @RenderBody()
    </main>

    <footer class="pie">
        AM Soluciones de Cámaras y Seguridad Electrónica &middot; Sistema de inventario y ventas
    </footer>
</body>
</html>
