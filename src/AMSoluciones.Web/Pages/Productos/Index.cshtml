@page
@model AMSoluciones.Web.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="encabezado-pagina">
    <div>
        <h1>Productos</h1>
        <p class="subtitulo">Catálogo de cámaras, grabadores y accesorios CCTV.</p>
    </div>
</div>

@if (Model.EsAdministrador)
{
    <div class="tarjeta">
        <h2>@(Model.Id is null ? "Nuevo producto" : "Editar producto")</h2>
        <form method="post" asp-page-handler="Guardar" class="formulario">
            <input type="hidden" name="Id" value="@Model.Id" />
            <label>
                Categoría
                <select name="CategoriaId" required>
                    <option value="">Seleccione...</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CategoriaId)">@c.Nombre</option>
                    }
                </select>
            </label>
            <label>
                SKU
                <input type="text" name="Sku" value="@Model.Sku" maxlength="32" placeholder="CAM-004" required />
            </label>
            <label>
                Nombre
                <input type="text" name="Nombre" value="@Model.Nombre" maxlength="120" required />
            </label>
            <label>
                Precio (RD$)
                <input type="number" name="Precio" step="0.01" min="0.01" max="999999.99"
                       value="@(Model.Precio == 0 ? "" : Model.Precio.ToString("0.00", CultureInfo.InvariantCulture))" required />
            </label>
            <button type="submit" class="boton boton-acento">@(Model.Id is null ? "Crear" : "Guardar cambios")</button>
            @if (Model.Id is not null)
            {
                <a class="boton boton-claro" style="color:#123a6b;border-color:#123a6b" asp-page="Index">Cancelar</a>
            }
        </form>
    </div>
}

<div class="tarjeta">
    @if (Model.Productos.Count == 0)
    {
        <p class="vacio">No hay productos registrados.</p>
    }
    else
    {
        <div class="tabla-contenedor">
            <table>
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th class="num">Precio</th>
                        @if (Model.EsAdministrador)
                        {
                            <th>Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Productos)
                    {
                        <tr>
                            <td>@p.Sku</td>
                            <td>@p.Nombre</td>
                            <td>@Model.NombreCategoria(p.CategoriaId)</td>
                            <td class="num">@Formato.Moneda(p.Precio)</td>
                            @if (Model.EsAdministrador)
                            {
                                <td>
                                    <div class="acciones">
                                        <a class="boton boton-pequeno" asp-page="Index" asp-route-editar="@p.Id">Editar</a>
                                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@p.Id" style="margin:0"
                                              onsubmit="return confirm('¿Eliminar el producto @p.Sku?');">
                                            <button type="submit" class="boton boton-pequeno boton-peligro">Eliminar</button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
